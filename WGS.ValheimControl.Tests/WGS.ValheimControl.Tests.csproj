<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <ItemGroup>
    <Compile Include="../WGS/Services/IsolatedConsoleProcess.cs" Link="IsolatedConsoleProcess.cs" />
    <Compile Include="../WGS/Services/ValheimShutdown.cs" Link="ValheimShutdown.cs" />
    <Compile Include="../WGS/Services/ValheimSaveEvidence.cs" Link="ValheimSaveEvidence.cs" />
    <ProjectReference Include="../WGS.ValheimControl/WGS.ValheimControl.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyControlHelper" AfterTargets="Build">
    <ItemGroup><Helper Include="../WGS.ValheimControl/bin/$(Configuration)/net10.0/$(RuntimeIdentifier)/WGS.ValheimControl*" /></ItemGroup>
    <Copy SourceFiles="@(Helper)" DestinationFolder="$(TargetDir)" />
  </Target>
</Project>
